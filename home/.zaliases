#alias vi='gvim'
alias vi='nvim'
alias sa='source ~/.zaliases'
alias vz='vi ~/.zshrc'
alias sz='source ~/.zshrc'
alias va='vi ~/.zaliases'
alias sl='ls'
alias h='history'
alias d='docker'
alias cs='colima start --cpu 4 --memory 12'
alias csk='colima start --kubernetes --cpu 4 --memory 12'
alias cptr='docker run -d -p 9443:9443 --name portainer --restart=always -v /var/run/docker.sock:/var/run/docker.sock -v portainer_data:/data portainer/portainer-ce:sts'
alias g='git'
alias p='pnpm'
alias k='kubectl'
alias n='node'
alias h='helm'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias cat='bat'

ls_cmd='ls'
if type 'gls' >/dev/null 2>&1; then
  ls_cmd='gls'
fi

if ${ls_cmd} --color >/dev/null 2>&1; then
  colorflag='--color'
else
  colorflag='-G'
fi

alias ls="${ls_cmd} ${colorflag}"
alias l="${ls_cmd} -l ${colorflag}"
alias la="${ls_cmd} -la ${colorflag}"
alias lsd="${ls_cmd} -l ${colorflag} | grep '^d'"
alias ll="${ls_cmd} -l ${colorflag}"

alias ag='rg'
