autoload -Uz add-zsh-hook vcs_info

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '+'
zstyle ':vcs_info:git:*' unstagedstr '!'
zstyle ':vcs_info:git:*' formats ' %b%c%u'
zstyle ':vcs_info:git:*' actionformats ' %b*%c%u'

add-zsh-hook precmd vcs_info
setopt prompt_subst

git_outstanding_marker() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return
  [[ -n "$(git status --porcelain 2>/dev/null)" ]] && print -n ' *'
}

PROMPT='%F{cyan}%n%f@%F{green}%m%f:%B%F{blue}%~%f%b${vcs_info_msg_0_:+ on}%F{red}%B${vcs_info_msg_0_}%b%f$(git_outstanding_marker)
$ '
