#!/usr/bin/env bash
set -euo pipefail

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "Not inside a git repository." >&2
  exit 1
}

mapfile -t entries < <(
  git worktree list --porcelain | awk '
    $1=="worktree" { wt=$2 }
    $1=="branch"   { sub("^refs/heads/","",$2); br=$2; print br "\t" wt }
  '
)

((${#entries[@]})) || {
  echo "No worktrees found." >&2
  exit 1
}

if command -v fzf >/dev/null 2>&1; then
  choice="$(
    printf '%s\n' "${entries[@]}" \
      | fzf --prompt="Worktree > " --height=40% --reverse --with-nth=1,2 --delimiter=$'\t'
  )" || exit 1
else
  echo "fzf not found; using basic chooser."
  i=1
  for e in "${entries[@]}"; do
    printf "%2d) %s\n" "$i" "${e//$'\t'/  ->  }"
    ((i++))
  done
  read -r -p "Pick number: " n
  [[ "$n" =~ ^[0-9]+$ ]] || exit 1
  ((n>=1 && n<=${#entries[@]})) || exit 1
  choice="${entries[n-1]}"
fi

printf '%s\n' "${choice#*$'\t'}"
